<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Потрібен для JobScheduler: перевірка підписок має обмеження
         «тільки з мережею» (NETWORK_TYPE_ANY), без цього дозволу
         schedule() кидає SecurityException і застосунок падає при запуску. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Доступ до файлів на Android 12 і старіше; на Android 13+ доступ до
         папок дає вибір через файловий менеджер (SAF), дозвіл не потрібен. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Сповіщення про прогрес завантаження (Android 13+ питає окремо). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
                android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="BookMriya"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Відкриття локальних файлів книг зовнішньою читалкою. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.allbooks.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Фонова перевірка підписок (JobScheduler, раз на день). -->
        <service
            android:name=".SubCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>

</manifest>

